#!name=9NB.DE每日签到
#!desc=9NB.DE论坛多账号签到。Argument填写账号:密码|账号:密码，脚本模拟登录并缓存Cookie，Cookie失效自动重新登录；默认08:00，随机手气签到。
#!author=Minis
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/9nb-checkin
#!icon=https://9nb.de/favicon.ico
#!loon_version=3.2.1(734)

[Argument]
cron = input,"0 8 * * *",tag=签到时间,desc=默认每天08:00执行，可按需修改
account1 = input,"",tag=账号1,desc=填写第1个9NB用户名
password1 = input,"",tag=密码1,desc=填写账号1密码
account2 = input,"",tag=账号2,desc=填写第2个9NB用户名
password2 = input,"",tag=密码2,desc=填写账号2密码
account3 = input,"",tag=账号3,desc=填写第3个9NB用户名
password3 = input,"",tag=密码3,desc=填写账号3密码
account4 = input,"",tag=账号4,desc=填写第4个9NB用户名
password4 = input,"",tag=密码4,desc=填写账号4密码
account5 = input,"",tag=账号5,desc=填写第5个9NB用户名
password5 = input,"",tag=密码5,desc=填写账号5密码

[Script]
http-request ^https:\/\/9nb\.de\/nb_checkin(?:[/?]|$) script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/9nb-checkin/9nb-checkin.js, timeout=30, tag=9NB捕获Cookie
cron {cron} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/9nb-checkin/9nb-checkin.js, timeout=1200, argument=[{account1},{password1},{account2},{password2},{account3},{password3},{account4},{password4},{account5},{password5}], tag=9NB每日签到

[MITM]
hostname = 9nb.de
