#!name=9NB.DE 每日签到
#!desc=9NB.DE 论坛多账号自动签到。Cookie 模式：在密码栏粘贴 bbs_auth=xxx（可从 VPS 或浏览器导出）。默认每天 08:05 执行。
#!author=Minis
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/9nb-checkin
#!icon=https://9nb.de/favicon.ico
#!loon_version=3.2.1(734)

[Argument]
cron = 5 8 * * *
account1 = 武则天
password1 = bbs_auth=在这里粘贴你的Cookie
account2 =
password2 =
account3 =
password3 =
account4 =
password4 =
account5 =
password5 =

[Script]
cron {cron} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/9nb-checkin/9nb-checkin.js, timeout=600, argument=[{account1},{password1},{account2},{password2},{account3},{password3},{account4},{password4},{account5},{password5}], tag=9NB每日签到
