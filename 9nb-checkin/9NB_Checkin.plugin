#!name=9NB.DE每日签到
#!desc=9NB.DE论坛多账号签到。Argument可填账号:密码或留空使用Loon自动捕获的浏览器Cookie；默认08:00，显示奖励和积分余额。
#!author=Minis
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/9nb-checkin
#!icon=https://9nb.de/favicon.ico
#!loon_version=3.2.1(734)

[Argument]
cron = input,"0 8 * * *",tag=签到时间,desc=默认每天08:00执行，可按需修改
accounts = input,"",tag=多账号,desc=可填账号1:密码1|账号2:密码2；也可留空，使用Loon自动捕获并保存的Cookie

[Script]
http-request ^https:\/\/9nb\.de\/nb_checkin(?:[/?]|$) script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/9nb-checkin/9nb-checkin.js, timeout=30, tag=9NB捕获Cookie
cron {cron} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/9nb-checkin/9nb-checkin.js, timeout=1200, argument=[{accounts}], tag=9NB每日签到

[MITM]
hostname = 9nb.de
