#!name=网上国网签到
#!desc=网上国网(国家电网 95598)积分每日签到。<b>R10（2026-11-03）新增受控自动恢复</b>：签到会话被官方 App 登录挤掉时，签到接口会回 RK001；旧版 R9 把它一律当风控直接停 30 分钟、永不重登，于是你只要开过 App 领奖励，脚本就长期失败。现在改为——<b>仅当本次复用了旧会话</b>时，自动重登一次再签到，并且<b>每天最多恢复一次</b>；重登后仍失败就停手并提示，不再循环。短信保护不变（15 分钟内不重发、每日最多 3 条）。<b>用手机号 + 密码自动登录，无需抓包、无需 MITM</b>；首次登录需短信验证码。<b>更新后请删除旧插件重新添加</b>，否则 Loon 会继续跑缓存里的旧脚本。
#!author=MaYIHEI（脚本）· Minis（Loon 外壳）
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/sgcc
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/sgcc.png
#!tag=签到
#!loon_version=3.5.1(983)

[Argument]
phone = input,"",tag=手机号,desc=网上国网登录手机号；留空则读 BoxJS
password = input,"",tag=密码,desc=网上国网登录密码；留空则读 BoxJS。⚠️ 密码连续输错 5 次会锁定 30 分钟，填错先改对再运行
sms = input,"",tag=短信验证码,desc=仅首次登录（提示新设备验证）时填，填完手动运行一次；成功后会自动清空
recover = switch,true,tag=会话被挤掉时自动恢复,desc=开：签到回 RK001 且本次用的是旧会话时，自动重登一次，每天最多一次。关：只提示，不重登
cron = input,"30 8 * * *",tag=签到时间,desc=默认每天 8:30，格式：分 时 日 月 周
debug = switch,false,tag=调试模式,desc=在 Loon 日志里打印服务器返回内容

[Script]
cron ${cron} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/sgcc/sgcc-r10.js", {${phone}, ${password}, ${sms}, ${debug}, ${recover}}) with tag="网上国网签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/sgcc.png", timeout=90
