#!name=Bing CN 多榜单无重复自动搜索 V6
#!desc=每天后台自动从百度、头条、微博、抖音热榜及天气接口汇总关键词，规范化跨榜单去重后严格使用cn.bing.com搜索22次，每次间隔随机20-40秒。首次安装只需登录并搜索一次抓Cookie。
#!author=Minis
#!homepage=https://cn.bing.com/
#!icon=https://www.bing.com/favicon.ico
#!loon_version=3.2.1(734)

[Argument]
appkey = input,"",tag=故梦呀 AppKey,desc=填写 api.gmya.net 的 AppKey；留空也会尝试公共接口
cron = input,"0 10 5 * * *",tag=每日执行时间,desc=cron 表达式，默认每天 05:10 自动搜索

[Script]
cron {cron} script-path=https://gist.githubusercontent.com/onshine/02e4a4b20253e434e426a0a7e40aa3ea/raw/bingcn-v5.js, timeout=1200, argument=[{appkey}], tag=BingCNUniqueSearch22V6

http-request ^https:\/\/cn\.bing\.com\/(?:$|search(?:\?|$)) script-path=https://gist.githubusercontent.com/onshine/3c11e14ea4b62dad79423c47cb037254/raw/bingcn-cookie-v4.js, requires-body=false, timeout=30, tag=BingCNCookieV6

[Mitm]
hostname = %APPEND% cn.bing.com
