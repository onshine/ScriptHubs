#!name=车来了每日签到
#!desc=车来了 App「7天连续签」自动签到并推送奖励结果。两条定时任务的时间都能在插件设置页直接改：主任务默认 00:01，补签兜底默认 08:05（已签则静默跳过、不打扰）。<b>首次需先打开车来了 →「每日签到」页一次</b>，脚本会自动抓取设备凭证（udid / accountId / secret），抓到时会有通知提示；之后每天定时自动签到。若一直抓不到凭证，可在设置页手动填写。<b>更新后请删除旧插件重新添加</b>，否则 Loon 可能仍在运行缓存里的旧脚本。
#!author=Minis
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/chelaile-checkin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
#!tag=签到
#!loon_version=3.5.0(975)

[Argument]
cron = input,"1 0 * * *",tag=主任务时间,desc=每天主签到时间，格式：分 时 日 月 周
cron_backup = input,"5 8 * * *",tag=补签兜底时间,desc=兜底补签时间，当天已签则静默跳过
udid = input,"",tag=udid,desc=一般留空，由抓包自动获取
accountId = input,"",tag=accountId,desc=一般留空，由抓包自动获取
secret = input,"",tag=secret,desc=一般留空，由抓包自动获取。签到接口必需，少了会报 0002
s = input,"1",tag=s,desc=签到接口要求非空即可，默认 1
notify_on_capture = switch,true,tag=抓到凭证时通知,desc=成功获取凭证后推送一次通知，同一个凭证只提示一次
notify_when_signed = switch,true,tag=已签到也通知,desc=当天已签到时也推送通知
debug = switch,false,tag=调试日志,desc=输出接口原始响应与命中记录（已自动脱敏）

[Script]
http-request ^https?:\/\/(?:[a-z0-9-]+\.)*(?:chelaile\.net\.cn|chelaileapp\.cn)\/|^https?:\/\/124\.(?:70\.194\.16|71\.153\.172)\/ script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, requires-body=false, timeout=30, tag=车来了抓凭证
cron {cron} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, timeout=300, argument=[{"udid":"{udid}","accountId":"{accountId}","secret":"{secret}","s":"{s}","notify_when_signed":"{notify_when_signed}","debug":"{debug}"}], tag=车来了签到
cron {cron_backup} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, timeout=300, argument=[{"udid":"{udid}","accountId":"{accountId}","secret":"{secret}","s":"{s}","notify_when_signed":"false","debug":"{debug}"}], tag=车来了补签兜底

[MitM]
hostname = %APPEND% web.chelaile.net.cn, api.chelaile.net.cn, cdn.api.chelaile.net.cn, cdn.api.chelaileapp.cn, cdn.web.chelaile.net.cn
