#!name=车来了每日签到
#!desc=车来了 App「7天连续签」自动签到并推送奖励结果。<b>首次需先打开车来了 →「每日签到」页一次</b>，脚本会自动抓取设备凭证（udid/accountId）；之后每天定时自动签到。若长期未开 App 需手动在 Argument 填 udid/accountId。<b>更新后请删除旧插件重新添加</b>，否则 Loon 可能仍在运行缓存里的旧脚本。
#!author=Minis
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/chelaile-checkin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
#!tag=签到
#!loon_version=3.5.1(998)

[Argument]
cron = input,"5 8 * * *",tag=每日执行时间,desc=cron 表达式，默认每天 08:05
udid = input,"",tag=UDID（一般留空）,desc=留空则用抓包自动捕获的值。手动填写时为 40 位十六进制
accountId = input,"",tag=账号ID（一般留空）,desc=留空则用抓包自动捕获的值。手动填写时为数字
notify_when_signed = switch,false,tag=已签到也通知,desc=当天已签到时也推送通知；默认只在签到有动作或出错时通知
debug = switch,false,tag=调试日志,desc=在运行日志里输出接口原始响应，排查时打开

[Script]
# 抓凭证：只读 URL，不读取 body，且原样放行
http-request ^https:\/\/web\.chelaile\.net\.cn\/api\/op-activity-api\/ script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, requires-body=false, timeout=30, argument=[{"udid":"{udid}","accountId":"{accountId}","debug":"{debug}"}], tag=车来了-抓凭证

# 每日签到
cron {cron} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, timeout=300, argument=[{"udid":"{udid}","accountId":"{accountId}","notify_when_signed":"{notify_when_signed}","debug":"{debug}"}], tag=车来了签到

[MitM]
hostname = %APPEND% web.chelaile.net.cn
