#!name=车来了每日签到
#!desc=车来了 App「7天连续签」自动签到并推送奖励结果。<b>首次需先打开车来了 →「每日签到」页一次</b>，脚本会自动抓取设备凭证（udid/accountId），抓到时会有通知提示；之后每天定时自动签到。若一直抓不到凭证，可在 Argument 里手动填 udid/accountId。<b>更新后请删除旧插件重新添加</b>，否则 Loon 可能仍在运行缓存里的旧脚本。
#!author=Minis
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/chelaile-checkin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
#!tag=签到
#!loon_version=3.5.0(975)

[Argument]
cron = 5 8 * * *
udid =
accountId =
notify_on_capture = true
notify_when_signed = true
debug = true

[Script]
http-request ^https:\/\/web\.chelaile\.net\.cn\/ script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, requires-body=false, timeout=30, tag=车来了抓凭证
cron {cron} script-path=https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js, timeout=300, argument=[{"udid":"{udid}","accountId":"{accountId}","notify_when_signed":"{notify_when_signed}","debug":"{debug}"}], tag=车来了签到

[MitM]
hostname = %APPEND% web.chelaile.net.cn
