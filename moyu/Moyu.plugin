#!name=摸鱼来啦
#!desc=每日「摸鱼」通知：今天几号、农历几月几日、距离周末/节日还有几天，可带黄历与节日祝福。<b>本版修好了农历生日</b>：像「老婆生日:3月15日$农历」这类写法，以前会把出生那年的农历换成公历、再原样套到今年，遇到春节前后还会整年错位或漏掉；现在每年都按<b>农历月日</b>重新换算，跨春节不回退，农历腊月/正月的生日也不会错，且不受出生年份影响。另外：卅日在只有 29 天的月份按廿九提醒，闰月年份缺失时自动退回普通同月，日期落在法定假期内时加一句提示。配置支持 BoxJS（同上游）或在插件设置里直接填，插件里的值优先。<b>更新后请删除旧插件重新添加</b>，否则 Loon 会继续跑缓存里的旧脚本。
#!author=Yuheng0101（原作）· ScriptHubs（修复）· 农历库 6tail（MIT）
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/moyu
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/67/04/ff/6704ff4c-b49b-de91-70ac-201c62d5296f/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-60x60@2x.png/60x60bb.png
#!tag=工具
#!loon_version=3.5.1(983)

[Argument]
moyu_cron = input,"6 9 * * *",tag=执行时间,desc=默认每天 9:06，格式：分 时 日 月 周
moyu_festival_conf = input,"<元宵节>&<清明节>&<劳动节>&<端午节>&<中秋节>&<国庆节>&<元旦>&<春节>&<母亲节>&<儿童节>&<父亲节>&<七夕节>&<情人节>",tag=节日与生日,desc=用 & 分隔；内置节日写 <名称>，自定义写 名称:日期$历法#祝福。例：老婆生日:10月27日$农历#祝老婆生日快乐&纪念日:1990年3月14日$阳历
moyu_remind_days = input,"50",type=string,tag=提前多少天提醒,desc=0～3660 的整数：距离超过这个天数的节日不显示，默认 50
moyu_show_almanac = switch,false,tag=显示黄历,desc=在通知里附加今日宜忌与节气
moyu_notify_with_media = switch,false,tag=通知带图片,desc=Loon 通知附带一张图片（部分系统版本可能不显示）
moyu_custom_notify_img = input,"",tag=通知图片链接,desc=留空则不带图
moyu_debug = switch,false,tag=调试模式,desc=在 Loon 日志里打印每个节日的换算结果与备注
moyu_bark_key = input,"",tag=Bark 推送 Key,desc=填了就走 Bark 推送，不再发系统通知；留空走系统通知

[Script]
cron ${moyu_cron} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/moyu/moyu.js", {${moyu_festival_conf}, ${moyu_remind_days}, ${moyu_show_almanac}, ${moyu_notify_with_media}, ${moyu_custom_notify_img}, ${moyu_debug}, ${moyu_bark_key}}) with tag="摸鱼来啦", timeout=60, img_url="https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/67/04/ff/6704ff4c-b49b-de91-70ac-201c62d5296f/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-60x60@2x.png/60x60bb.png"
