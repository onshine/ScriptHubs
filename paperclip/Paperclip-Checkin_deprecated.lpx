cron ${teld_cron} then script("https://gist.githubusercontent.com/onshine/9cb869dc3ca5f1ada8353043053b31cc/raw/teld.js"), tag="特来电签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/teld.png", timeout=60, enable=${teld}
cron ${songshan_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/songshan/songshan.js"), tag="松山棉店签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/songshan.png", enable=${songshan}
