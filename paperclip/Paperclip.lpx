request if ${url} ~= /^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock$/i && ${request.header['x-lf-channel']} == "C2" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/lhtj/lhtj.js") with enable=${lhtj_cookie}, tag="龙湖天街 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png"

# ---- 【味多美】签到 ----
cron ${wedome_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/wedome/wedome.js") with tag="味多美签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wedome.png", timeout=60, enable=${wedome}
response if ${url} ~= /^https:\/\/scrm-b\.zjian\.net\//i then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/wedome/wedome.js") with enable=${wedome_cookie}, tag="味多美 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wedome.png", requires_body=true

# ---- 【北京华联】签到 ----
cron ${bhg_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/bhg/bhg.js") with tag="北京华联签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bhg.png", timeout=60, enable=${bhg}
request if ${url} ~= /https:\/\/a\.china-smartech\.com\/restful\/mall\/\d+\/checkInForm/i && ${request.header['referer']} ~= /wx1b1dda695dff82c8/ then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/bhg/bhg.js") with enable=${bhg_cookie}, tag="北京华联 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bhg.png"

# ---- 【林里】签到 ----
cron ${linli_cron} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/linli/linli.js") with tag="林里签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linli.png", timeout=60, enable=${linli}
request if ${url} ~= /^https:\/\/webapi\.qmai\.cn\//i then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/linli/linli.js") with enable=${linli_cookie}, tag="林里 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/linli.png", requires_body=true

# ==== 上游插件未收录、本外壳补充的 4 个 ====

# ---- 【特来电】签到 ----
cron ${teld_cron} then script("https://gist.githubusercontent.com/onshine/9cb869dc3ca5f1ada8353043053b31cc/raw/teld.js") with tag="特来电签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/teld.png", timeout=60, enable=${teld}
request if ${url} ~= /^https:\/\/sgi\.teld\.cc\/api\/invoke/i then script("https://gist.githubusercontent.com/onshine/9cb869dc3ca5f1ada8353043053b31cc/raw/teld.js") with enable=${teld_cookie}, tag="特来电 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/teld.png"

# ---- 【松山棉店】签到 ----
cron ${songshan_cron} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/songshan/songshan.js") with tag="松山棉店签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/songshan.png", timeout=60, enable=${songshan}
request if ${url} ~= /^https:\/\/xapi\.weimob\.com\/api3\/onecrm\/mactivity\/sign\/misc\/sign\/activity\/(c\/signMainInfo|core\/c\/(getActivityInfo|sign))/i then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/songshan/songshan.js") with enable=${songshan_cookie}, tag="松山棉店 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/songshan.png", requires_body=true

# ---- 【笔笔省】领券 ----
cron ${bibisheng_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/bibisheng/bibisheng.js") with tag="笔笔省领券", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bibisheng.png", timeout=60, enable=${bibisheng}
request if ${url} ~= /^https:\/\/discount\.wxpapp\.wechatpay\.cn\/txbbs-mall\/coupon\/(querydailygiftcoupons|claimdailygiftcoupon)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/bibisheng/bibisheng.cookie.js") with enable=${bibisheng_cookie}, tag="笔笔省 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/bibisheng.png"

# ---- 【CASETiFY】签到 ----
cron ${casetify_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/casetify/casetify.js") with tag="CASETiFY签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/casetify.png", timeout=60, enable=${casetify}
response if ${url} ~= /^https:\/\/mini-app-api\.casetify\.cn\/api\/v4\/estore\/member\/checkWebToken/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/miniprogram/casetify/casetify.js") with enable=${casetify_cookie}, tag="CASETiFY Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/casetify.png", requires_body=true


# ==== 车来了签到：先抓凭证，再定时签到 + 兜底补签 ====
request if ${url} ~= /^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js") with enable=${PingMe}, tag="PingMe获取签到参数", timeout=60
cron ${PingMe_cron} then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js") with enable=${PingMe}, tag="PingMe签到", timeout=300
request if ${url} ~= /^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus/i then script("https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Scripts/WeTalk/WeTalk.js") with enable=${WeTalk}, tag="WeTalk抓账号", timeout=60
cron ${WeTalk_cron} then script("https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Scripts/WeTalk/WeTalk.js") with enable=${WeTalk}, tag="WeTalk签到", timeout=300
request if ${url} ~= /^https?:\/\/(?:[a-z0-9-]+\.)*(?:chelaile\.net\.cn|chelaileapp\.cn)\/|^https?:\/\/124\.(?:70\.194\.16|71\.153\.172)\//i then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js", {udid: ${cl_udid}, accountId: ${cl_accountId}, notify_on_capture: ${cl_notify_on_capture}, debug: ${cl_debug}}) with tag="车来了抓凭证", img_url="https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png", timeout=30
cron ${cl_cron} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js", {udid: ${cl_udid}, accountId: ${cl_accountId}, secret: ${cl_secret}, s: ${cl_s}, notify_when_signed: ${cl_notify_when_signed}, debug: ${cl_debug}}) with tag="车来了签到", img_url="https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png", timeout=300
cron ${cl_cron_backup} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile-checkin/chelaile-checkin.js", {udid: ${cl_udid}, accountId: ${cl_accountId}, secret: ${cl_secret}, s: ${cl_s}, silent_when_signed: ${cl_backup_silent}, debug: ${cl_debug}}) with tag="车来了补签兜底", img_url="https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png", timeout=300

# ==== 车来了去广告（响应清洗） ====
response if ${url} ~= /^https?:\/\/[^\/]+\/(?:api\/)?(?:bus-side\/appToggle\/getStatus|goocity\/flowPos\/home|goocity\/flowPos\/listByPos|goocity\/city!|goocity\/config\/notices|encourage\/activity\/control|operative_position\/infoflow|led-weather\/[^\/]*\/condition_brief)|^https?:\/\/adx\.yg84\.com\/sdk\/ad\/|^https?:\/\/ssp\.yg84\.com\/ssp\/(?:ad\/list|tracking\/)/i then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/chelaile/chelaile-ads.js", {remove_splash: ${ads_remove_splash}, remove_ad_sdk: ${ads_remove_ad_sdk}, remove_home_grid: ${ads_remove_home_grid}, remove_feed: ${ads_remove_feed}, remove_notice: ${ads_remove_notice}, block_httpdns: ${ads_block_httpdns}, debug: ${ads_debug}}) with tag="车来了去广告", img_url="https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png", requires_body=true, timeout=30

# ==== Bing CN 自动搜索 + 抓 Cookie ====
cron ${bing_cron} then script("https://gist.githubusercontent.com/onshine/02e4a4b20253e434e426a0a7e40aa3ea/raw/bingcn-v6.js", {appkey: ${bing_appkey}}) with tag="BingCN 多榜单搜索", img_url="https://www.bing.com/favicon.ico", timeout=1200
request if ${url} ~= /^https:\/\/cn\.bing\.com\/(?:$|search(?:\?|$))/i then script("https://gist.githubusercontent.com/onshine/3c11e14ea4b62dad79423c47cb037254/raw/bingcn-cookie-v4.js") with tag="BingCN 抓Cookie", img_url="https://www.bing.com/favicon.ico", timeout=30

[Rule]
# 车来了自己的广告与埋点（不需要 MITM）
DOMAIN, ad.chelaile.net.cn, REJECT
DOMAIN, atrace.chelaile.net.cn, REJECT
DOMAIN, logs.chelaile.net.cn, REJECT
# 开屏广告来源：yg84 广告 SDK（adx 调度 / ssp 素材 / ctrace 埋点同根域）
DOMAIN-SUFFIX, yg84.com, REJECT
# 第三方广告 SDK：穿山甲、百度
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao1.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao-b.com, REJECT
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT
DOMAIN-SUFFIX, sofire.baidu.com, REJECT
# 开屏广告曝光确认像素
DOMAIN, m.magicacid.cn, REJECT

[Rewrite]
^https?:\/\/pic1\.chelaile\.net\.cn\/adv\/ reject
^https?:\/\/[^\/]+\/(?:api\/)?adpub reject
^https?:\/\/[^\/]+\/goocity\/advert reject
^https?:\/\/124\.70\.194\.16\/(?:ip|adpub) reject
^https?:\/\/124\.71\.153\.172\/(?:ip|adpub) reject
^https?:\/\/cdn\.[a-z0-9]+\.chelaileapp\.cn\/(?:api\/)?adpub reject
^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html reject
^https?:\/\/[^\/]+\/feserver\/vip-page\/images\/ reject
^https?:\/\/image3\.chelaile\.net\.cn\/hw6u6LYY\.png reject-img

[MITM]
hostname = %APPEND% api.weibo.cn, pbaccess.video.qq.com, vip.video.qq.com, api-takumi.miyoushe.com, api-takumi.mihoyo.com, app.mixcapp.com, shop-api.retail.mi.com, m.xiaomiyoupin.com, gw2c-hw-open.longfor.com, u6.y.qq.com, user-api-prd-mx.wandafilm.com, xunting.vbegin.com.cn, personal-act.wps.cn, api-cs.intsig.net, cn-wxmall.dreame.tech, cn-yx-wxmall.dreame.tech, www.nodeseek.com, pan1.me, pan.baidu.com, app-gw.shuye.com, popvip.paquapp.com, api.tuhu.cn, superapp-public.kiwa-tech.com, media.meituan.com, member-center.miniso.com, a.china-smartech.com, scrm-b.zjian.net, webapi.qmai.cn, sgi.teld.cc, c2.teld.cc, api.chelaile.net.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, cdn.api.chelaile.net.cn, image3.chelaile.net.cn, pic1.chelaile.net.cn, adx.yg84.com, ssp.yg84.com, 124.70.194.16, 124.71.153.172, cn.bing.com, api.pingmeapp.net, api.wetalkapp.com
