cl_cron = input,"1 0 * * *",tag=【车来了签到】主任务时间,desc=顺序是「分 时 日 月 周」。例：1 0 * * * 每天 00:01；30 8 * * * 每天 08:30
cl_cron_backup = input,"5 8 * * *",tag=　└ 补签兜底时间,desc=当天已签则静默跳过，默认每天 08:05
cl_udid = input,"",tag=　└ udid,desc=一般留空，由抓包自动获取
cl_accountId = input,"",tag=　└ accountId,desc=一般留空，由抓包自动获取
cl_secret = input,"",tag=　└ secret,desc=一般留空，由抓包自动获取。签到接口必需，少了会报 0002
cl_s = input,"1",tag=　└ s,desc=签到接口要求非空即可，默认 1
cl_notify_on_capture = switch,true,tag=　└ 抓到凭证时通知,desc=同一个凭证只提示一次
cl_notify_when_signed = switch,true,tag=　└ 已签到也通知,desc=当天已签到时也推送通知
cl_backup_silent = switch,true,tag=　└ 兜底静默,desc=兜底那趟当天已签时不通知
cl_debug = switch,false,tag=　└ 调试日志,desc=输出接口原始响应（已自动脱敏）

ads_remove_splash = switch,true,tag=【车来了去广告】去开屏/插屏,desc=清洗启动配置里的开屏、插屏、预加载开关，建议保持开启
ads_remove_ad_sdk = switch,true,tag=　└ 掐断广告SDK(yg84),desc=清空 adx 调度与 ssp 素材，去开屏的关键项
ads_remove_home_grid = switch,true,tag=　└ 去首页金刚位推广,desc=保留地铁、站点地图等功能入口
ads_remove_feed = switch,true,tag=　└ 去信息流/文章推荐,desc=移除详情页推荐与城市列表推广图
ads_remove_notice = switch,true,tag=　└ 去公告/活动弹窗,desc=移除公告、活动控制、LED 天气条
ads_block_httpdns = switch,true,tag=　└ 防 DNS 绕过,desc=移除配置里的 useHttpDns / 备用域名，防止绕过 Loon
ads_debug = switch,false,tag=　└ 调试日志,desc=输出每个接口的处理结果，排查时打开

bing_appkey = input,"",tag=【Bing CN 搜索】AppKey,desc=api.gmya.net 的 AppKey；留空也会尝试公共接口
bing_cron = input,"10 5 * * *",tag=　└ 每日执行时间,desc=默认每天 05:10（原插件是六段写法，Loon 用五段）

PingMe = switch,true,tag=【PingMe】签到 + 视频奖励,desc=关掉后抓包与定时签到都不执行；首次打开 PingMe 登录后自动抓凭证
PingMe_cron = input,"30 8,20 * * *",tag=　└ 签到时间,desc=默认每天 8:30 与 20:30 各一次，格式：分 时 日 月 周
WeTalk = switch,true,tag=【WeTalk】签到 + 视频奖励,desc=关掉后抓包与定时签到都不执行；首次打开 WeTalk 登录后自动抓凭证
WeTalk_cron = input,"20 8,20 * * *",tag=　└ 签到时间,desc=默认每天 8:20 与 20:20 各一次，格式：分 时 日 月 周

[Script]


# ==== 【摸鱼来啦】〔日历〕—— 不是签到，不参与 Cookie 抓取与统一汇总 ====
cron ${moyu_cron} then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/moyu/moyu.js", {${moyu_festival_conf}, ${moyu_remind_days}}) with enable=${moyu}, tag="摸鱼〔日历〕", img_url="https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/67/04/ff/6704ff4c-b49b-de91-70ac-201c62d5296f/AppIcon-0-0-1x_U007emarketing-0-0-0-5-0-0-sRGB-60x60@2x.png/60x60bb.png", timeout=60

# ==== 【彩票查询】双色球 / 大乐透 / 福彩3D / 排列三 / 七乐彩 —— 不参与签到汇总 ====
cron ${ssq_cron} then script("https://gist.githubusercontent.com/onshine/c1aedd94894ac23c0035a810fd631097/raw/ssq.js") with tag="彩票查询", img_url="https://raw.githubusercontent.com/58xinian/icon/master/Two_color_ball.png", timeout=300, enable=${ssq}

# ==== 各脚本：先签到，紧跟它自己的 Cookie 抓取 ====

# ---- 【微博超话】签到 ----
