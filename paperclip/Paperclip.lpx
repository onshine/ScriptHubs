#!name=Paperclip · 签到 + Cookie 合体（onshine 外壳）
#!desc=Paperclip 全套签到脚本与 Cookie 抓取，<b>一个插件搞定</b>。脚本本体一并<a href="https://github.com/MaYIHEI/paperclip">引用上游 MaYIHEI/paperclip</a>（不内置），作者更新这里自动跟上。<b>规则成对排布</b>：每个脚本「签到」一条，紧跟其下就是它自己的「Cookie 抓取」一条；开关也成对——上面是<b>签到开关</b>（默认开），下面是<b>抓取开关</b>（默认关，要抓才开）。没抓过 Cookie 的脚本自动跳过签到。相比作者原插件：⓪<b>摸鱼默认关闭，需在设置里打开</b>；⓪<b>第二位新增「摸鱼〔日历〕」</b>：摸鱼信息 + 节日/生日倒计时，时间和节日生日配置都在插件里改，不参与签到/汇总/取 Cookie；①每个脚本签到时间可改（留空＝上游默认）；②汇总时间可改；③修掉上游「小米抽奖」<code>0 30 7 * * *</code> 六段 cron 永不触发；④补特来电、松山棉店、笔笔省、CASETiFY 4 个脚本（<b>特来电引用你的 gist 原文，一个字没改</b>）；⑤MITM 用 %APPEND% 追加，不覆盖其它插件；⑥<b>末尾新增车来了签到、车来了去广告、Bing CN 搜索</b>三项，参数与时间都在插件里改；⑦<b>车来了上面新增 PingMe 与 WeTalk</b>（签到 + 视频奖励）。⚠️ 与原插件<b>二选一</b>：先删掉作者的「签到合集」和「Cookie 抓取合集」再装这个。需 Loon 3.5.1(983)+。<b>更新后下拉刷新插件即可，已填参数会保留</b>。<b>每个脚本签到完各自弹通知，不合并。</b>
#!author=MaYIHEI（脚本）· Minis（Loon 外壳）
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/paperclip
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png
#!tag=签到, Cookie
#!loon_version=3.5.1(983)

[Argument]
moyu_festival_conf = input,"<元宵节>&<清明节>&<劳动节>&<端午节>&<中秋节>&<国庆节>&<元旦>&<春节>&<母亲节>&<儿童节>&<父亲节>&<七夕节>&<情人节>",tag=【摸鱼来啦】〔日历〕节日与生日倒计时,desc=用 & 分隔：内置节日写 <名称>，自定义写 名称:日期$农历或$阳历，当天祝福用 # 接在后面；农历生日每年按农历换算。示例：某人生日:10月27日$农历#生日快乐
moyu = switch,false,tag=【摸鱼来啦】〔日历〕开关,desc=默认关闭；打开后每天推送摸鱼信息、农历日期与节日/生日倒计时
moyu_cron = input,"09 5 * * *",tag=　└ 执行时间,desc=默认 09 5 * * *，可改（分 时 日 月 周）
moyu_remind_days = input,"50",tag=　└ 提前多少天提醒,desc=0～3660 的整数，默认 50
ssq = switch,true,tag=【彩票查询】双色球等近5种彩票,desc=每晚 21:30 推送最近 15 期 + 今日开奖号码；不需要可关掉
ssq_cron = input,"30 21 * * *",tag=　└ 执行时间,desc=默认 30 21 * * *（开奖后半小时），可改
weibotalk = switch,true,tag=【微博超话】签到,desc=签到开关，默认 00 5 * * *
weibotalk_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
weibotalk_cron = input,"00 5 * * *",tag=　└ 签到时间,desc=默认 00 5 * * *，可改
tenvideo = switch,true,tag=【腾讯视频】签到,desc=签到开关，默认 03 5 * * *
tenvideo_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
tenvideo_cron = input,"03 5 * * *",tag=　└ 签到时间,desc=默认 03 5 * * *，可改
mihoyo = switch,true,tag=【米游社】签到,desc=签到开关，默认 06 5 * * *
mihoyo_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
mihoyo_cron = input,"06 5 * * *",tag=　└ 签到时间,desc=默认 06 5 * * *，可改
