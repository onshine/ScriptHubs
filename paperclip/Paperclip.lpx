#!name=Paperclip · 签到 + Cookie 合体（onshine 外壳）
#!desc=Paperclip 全套签到脚本与 Cookie 抓取，<b>一个插件搞定</b>。脚本本体一并<a href="https://github.com/MaYIHEI/paperclip">引用上游 MaYIHEI/paperclip</a>（不内置），作者更新这里自动跟上。<b>规则成对排布</b>：每个脚本「签到」一条，紧跟其下就是它自己的「Cookie 抓取」一条；开关也成对——上面是<b>签到开关</b>（默认开），下面是<b>抓取开关</b>（默认关，要抓才开）。没抓过 Cookie 的脚本自动跳过签到。「统一通知」打开后每天一条汇总，关闭则各自推送。相比作者原插件：①每个脚本签到时间可改（留空＝上游默认）；②汇总时间可改；③修掉上游「小米抽奖」<code>0 30 7 * * *</code> 六段 cron 永不触发；④补特来电、松山棉店、笔笔省、CASETiFY 4 个脚本（<b>特来电引用你的 gist 原文，一个字没改</b>）；⑤MITM 用 %APPEND% 追加，不覆盖其它插件。⚠️ 与原插件<b>二选一</b>：先删掉作者的「签到合集」和「Cookie 抓取合集」再装这个。需 Loon 3.5.1(983)+。<b>更新后请删除旧插件重新添加</b>。
#!author=MaYIHEI（脚本）· Minis（Loon 外壳）
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/paperclip
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png
#!tag=签到, Cookie
#!loon_version=3.5.1(983)

[Argument]
merge = switch,false,tag=【统一通知】每天一条汇总,desc=打开后各脚本不再单独弹通知，按「汇总时间」统一发一条；关闭则各自推送
summary_cron = input,"0 7 * * *",tag=　└ 汇总时间,desc=默认 0 7 * * *（最后一个签到 6:48 之后）
weibotalk = switch,false,tag=【微博超话】签到,desc=签到开关，默认 00 5 * * *
weibotalk_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
weibotalk_cron = input,"00 5 * * *",tag=　└ 签到时间,desc=默认 00 5 * * *，可改
tenvideo = switch,false,tag=【腾讯视频】签到,desc=签到开关，默认 03 5 * * *
tenvideo_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
tenvideo_cron = input,"03 5 * * *",tag=　└ 签到时间,desc=默认 03 5 * * *，可改
mihoyo = switch,false,tag=【米游社】签到,desc=签到开关，默认 06 5 * * *
mihoyo_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
mihoyo_cron = input,"06 5 * * *",tag=　└ 签到时间,desc=默认 06 5 * * *，可改
newmixc = switch,false,tag=【一点万象】签到,desc=签到开关，默认 09 5 * * *
newmixc_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
newmixc_cron = input,"09 5 * * *",tag=　└ 签到时间,desc=默认 09 5 * * *，可改
mishop = switch,false,tag=【小米商城】签到,desc=签到开关，默认 12 5 * * *
mishop_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
mishop_cron = input,"12 5 * * *",tag=　└ 签到时间,desc=默认 12 5 * * *，可改
milottery = switch,false,tag=【小米抽奖】签到,desc=签到开关，默认 15 5 * * *
milottery_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
milottery_cron = input,"15 5 * * *",tag=　└ 签到时间,desc=默认 15 5 * * *，可改
youpin = switch,false,tag=【小米有品】签到,desc=签到开关，默认 18 5 * * *
youpin_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
youpin_cron = input,"18 5 * * *",tag=　└ 签到时间,desc=默认 18 5 * * *，可改
lhtj_app = switch,false,tag=【龙湖天街 App】签到,desc=签到开关，默认 21 5 * * *
lhtj_app_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
lhtj_app_cron = input,"21 5 * * *",tag=　└ 签到时间,desc=默认 21 5 * * *，可改
qqmusic = switch,false,tag=【QQ音乐】签到与任务,desc=签到开关；三条任务各用下面三个时间
qqmusic_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
qqmusic_task_cron = input,"24 5 * * *",tag=　└ QQ音乐每日任务时间,desc=默认 24 5 * * *，可改
qqmusic_coin_cron = input,"27 5 * * *",tag=　└ QQ音乐定时金币时间,desc=默认 27 5 * * *，可改
qqmusic_rain_cron = input,"30 5 * * *",tag=　└ QQ音乐红包雨时间,desc=默认 30 5 * * *，可改
wanda = switch,false,tag=【万达电影】签到,desc=签到开关，默认 33 5 * * *
wanda_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
wanda_cron = input,"33 5 * * *",tag=　└ 签到时间,desc=默认 33 5 * * *，可改
tingtingfm = switch,false,tag=【听听FM】签到,desc=签到开关，默认 36 5 * * *
tingtingfm_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
tingtingfm_cron = input,"36 5 * * *",tag=　└ 签到时间,desc=默认 36 5 * * *，可改
wps = switch,false,tag=【WPS】签到与福利,desc=签到开关，默认 39 5 * * *
wps_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
wps_cron = input,"39 5 * * *",tag=　└ 签到时间,desc=默认 39 5 * * *，可改
camscanner = switch,false,tag=【扫描全能王】抽奖,desc=签到开关，默认 42 5 * * *
camscanner_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
camscanner_cron = input,"42 5 * * *",tag=　└ 签到时间,desc=默认 42 5 * * *，可改
dreame = switch,false,tag=【追觅】签到,desc=签到开关，默认 45 5 * * *
dreame_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
dreame_cron = input,"45 5 * * *",tag=　└ 签到时间,desc=默认 45 5 * * *，可改
linghu = switch,false,tag=【灵狐灵购】签到,desc=签到开关，默认 48 5 * * *
linghu_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
linghu_cron = input,"48 5 * * *",tag=　└ 签到时间,desc=默认 48 5 * * *，可改
nodeseek = switch,false,tag=【NodeSeek】签到,desc=签到开关，默认 51 5 * * *
nodeseek_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
nodeseek_cron = input,"51 5 * * *",tag=　└ 签到时间,desc=默认 51 5 * * *，可改
pan1 = switch,false,tag=【123社区】签到,desc=签到开关，默认 54 5 * * *
pan1_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
pan1_cron = input,"54 5 * * *",tag=　└ 签到时间,desc=默认 54 5 * * *，可改
agentrouter = switch,false,tag=【AgentRouter · onshine 本地版】签到,desc=用本仓库 agentrouter/agentrouter.js（非上游），默认 57 5 * * *；开关与下面四个参数都只对这个脚本生效
username = input,"",tag=　└ 账号（onshine版）,desc=网站账号或邮箱；用多账号 JSON 时可留空
password = input,"",tag=　└ 密码（onshine版）,desc=网站登录密码
accounts = input,"",tag=　└ 多账号 JSON（onshine版）,desc=选填，填了优先用列表；格式见插件主页 README
debug = switch,false,tag=　└ 调试日志（onshine版）
agentrouter_cron = input,"57 5 * * *",tag=　└ 签到时间,desc=默认 57 5 * * *，可改
sgcc = switch,false,tag=【网上国网 · onshine 本地版】签到,desc=用本仓库 sgcc/sgcc.js（手机号+密码自动登录，无需抓包），默认 00 6 * * *
sgcc_phone = input,"",tag=　└ 手机号,desc=网上国网登录手机号
sgcc_password = input,"",tag=　└ 密码,desc=登录密码；⚠️ 连错 5 次锁 30 分钟，填错先改对再运行
sgcc_sms = input,"",tag=　└ 短信验证码,desc=仅首次登录（新设备验证）填，填完手动运行一次
sgcc_debug = switch,false,tag=　└ 调试日志
sgcc_cron = input,"00 6 * * *",tag=　└ 签到时间,desc=默认 00 6 * * *，可改
baidunetdisk = switch,false,tag=【百度网盘】成长值签到,desc=签到开关，默认 03 6 * * *
baidunetdisk_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
baidunetdisk_cron = input,"03 6 * * *",tag=　└ 签到时间,desc=默认 03 6 * * *，可改
laifen = switch,false,tag=【徕芬】签到,desc=签到开关，默认 06 6 * * *
laifen_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
laifen_cron = input,"06 6 * * *",tag=　└ 签到时间,desc=默认 06 6 * * *，可改
ppmt = switch,false,tag=【泡泡玛特】签到,desc=签到开关，默认 09 6 * * *
ppmt_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
ppmt_cron = input,"09 6 * * *",tag=　└ 签到时间,desc=默认 09 6 * * *，可改
tuhu = switch,false,tag=【途虎养车】签到,desc=签到开关，默认 12 6 * * *
tuhu_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
tuhu_cron = input,"12 6 * * *",tag=　└ 签到时间,desc=默认 12 6 * * *，可改
haidilao = switch,false,tag=【海底捞】签到,desc=签到开关，默认 15 6 * * *
haidilao_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
haidilao_cron = input,"15 6 * * *",tag=　└ 签到时间,desc=默认 15 6 * * *，可改
huisheng = switch,false,tag=【惠省红包墙】领券,desc=签到开关，默认 18 6 * * *
huisheng_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
huisheng_cron = input,"18 6 * * *",tag=　└ 签到时间,desc=默认 18 6 * * *，可改
miniso = switch,false,tag=【名创优品】签到,desc=签到开关，默认 21 6 * * *
miniso_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
miniso_cron = input,"21 6 * * *",tag=　└ 签到时间,desc=默认 21 6 * * *，可改
longde = switch,false,tag=【龙德广场】签到,desc=签到开关，默认 24 6 * * *
longde_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
longde_cron = input,"24 6 * * *",tag=　└ 签到时间,desc=默认 24 6 * * *，可改
lhtj = switch,false,tag=【龙湖天街】签到,desc=签到开关，默认 27 6 * * *
lhtj_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
lhtj_cron = input,"27 6 * * *",tag=　└ 签到时间,desc=默认 27 6 * * *，可改
wedome = switch,false,tag=【味多美】签到,desc=签到开关，默认 30 6 * * *
wedome_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
wedome_cron = input,"30 6 * * *",tag=　└ 签到时间,desc=默认 30 6 * * *，可改
bhg = switch,false,tag=【北京华联】签到,desc=签到开关，默认 33 6 * * *
bhg_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
bhg_cron = input,"33 6 * * *",tag=　└ 签到时间,desc=默认 33 6 * * *，可改
linli = switch,false,tag=【林里】签到,desc=签到开关，默认 36 6 * * *
linli_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
linli_cron = input,"36 6 * * *",tag=　└ 签到时间,desc=默认 36 6 * * *，可改
teld = switch,false,tag=【特来电】签到,desc=签到开关，默认 39 6 * * *
teld_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
teld_cron = input,"39 6 * * *",tag=　└ 签到时间,desc=默认 39 6 * * *，可改
songshan = switch,false,tag=【松山棉店】签到,desc=签到开关，默认 42 6 * * *
songshan_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
songshan_cron = input,"42 6 * * *",tag=　└ 签到时间,desc=默认 42 6 * * *，可改
bibisheng = switch,false,tag=【笔笔省】领券,desc=签到开关，默认 45 6 * * *
bibisheng_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
bibisheng_cron = input,"45 6 * * *",tag=　└ 签到时间,desc=默认 45 6 * * *，可改
casetify = switch,false,tag=【CASETiFY】签到,desc=签到开关，默认 48 6 * * *
casetify_cookie = switch,false,tag=　└ 取 Cookie,desc=要抓时才开；抓完关掉
casetify_cron = input,"48 6 * * *",tag=　└ 签到时间,desc=默认 48 6 * * *，可改

[Script]

# ==== 签到汇总 ====
cron ${summary_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/summary/summary.js", {${weibotalk}, ${tenvideo}, ${mihoyo}, ${newmixc}, ${mishop}, ${milottery}, ${youpin}, ${lhtj_app}, ${qqmusic}, ${wanda}, ${tingtingfm}, ${wps}, ${camscanner}, ${dreame}, ${linghu}, ${nodeseek}, ${pan1}, ${agentrouter}, ${sgcc}, ${baidunetdisk}, ${laifen}, ${ppmt}, ${tuhu}, ${haidilao}, ${huisheng}, ${miniso}, ${longde}, ${lhtj}, ${wedome}, ${bhg}, ${linli}) with tag="签到汇总", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png", enable=${merge}

# ==== 各脚本：先签到，紧跟它自己的 Cookie 抓取 ====

# ---- 【微博超话】签到 ----
cron ${weibotalk_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/weibotalk/weibotalk.js", {${merge}}) with tag="微博超话签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/weibo.png", enable=${weibotalk}
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/(statuses\/container_timeline_topicsub|page\/button)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/weibotalk/weibotalk.cookie.js") with enable=${weibotalk_cookie}, tag="微博超话 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/weibo.png", requires_body=true

# ---- 【腾讯视频】签到 ----
cron ${tenvideo_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/tenvideo/tenvideo.js", {${merge}}) with tag="腾讯视频签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tenvideo.png", enable=${tenvideo}
request if ${url} ~= /^https:\/\/pbaccess\.video\.qq\.com\//i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/tenvideo/tenvideo.js") with enable=${tenvideo_cookie}, tag="腾讯视频 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/tenvideo.png"

# ---- 【米游社】签到 ----
cron ${mihoyo_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mihoyo/mihoyo.js", {${merge}}) with tag="米游社签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mihoyo.png", enable=${mihoyo}
response if ${url} ~= /^https:\/\/api-takumi\.(miyoushe|mihoyo)\.com\/(binding\/api\/getUserGameRolesByStoken|event\/luna\/)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mihoyo/mihoyo.cookie.js") with enable=${mihoyo_cookie}, tag="米游社 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mihoyo.png", requires_body=true

# ---- 【一点万象】签到 ----
cron ${newmixc_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.js", {${merge}}) with tag="一点万象签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png", enable=${newmixc}
request if ${url} ~= /^https:\/\/app\.mixcapp\.com\/mixc\/api\/v4\/member\/getPersonalData/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.cookie.js") with enable=${newmixc_cookie}, tag="一点万象 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png"

# ---- 【小米商城】签到 ----
cron ${mishop_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.js", {${merge}}) with tag="小米商城签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", enable=${mishop}
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/mf\/act\/infinite\/(do|done)/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/mishop/mishop.cookie.js") with enable=${mishop_cookie}, tag="小米商城 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png"

# ---- 【小米抽奖】签到 ----
cron ${milottery_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js", {${merge}}) with tag="小米抽奖签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", timeout=360, enable=${milottery}
request if ${url} ~= /^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js") with enable=${milottery_cookie}, tag="小米抽奖 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png", requires_body=true

# ---- 【小米有品】签到 ----
cron ${youpin_cron} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/youpin/youpin.js", {${merge}}) with tag="有品签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/youpin.png", enable=${youpin}
request if ${url} ~= /^https:\/\/m\.xiaomiyoupin\.com\/mtop\/act\/redPacketSign\/getActInfo/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/youpin/youpin.js") with enable=${youpin_cookie}, tag="有品 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/youpin.png"

# ---- 【龙湖天街 App】签到 ----
