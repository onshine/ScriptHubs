#!name=AgentRouter签到 · ScriptHubs 本地版（onshine）
#!desc=每日自动签到，查看奖励、余额与累计消耗；多账号间随机等待 0～5 分钟。<b>r8.4：同步上游 2026-10-20.r7</b> —— 新增签到状态登记（供「签到汇总」使用）、全角 ＄ 奖励识别、BoxJS 回退、统一通知合并；同时<b>保留 0～5 分钟随机等待</b>与 Loon 无参 $done 兼容处理。脚本本体内置在本仓库 <code>agentrouter/agentrouter.js</code>，不随上游变动。<b>与「AgentRouter签到 · 上游原版」二选一</b>，同时开会重复签到。<b>更新后请删除旧插件重新添加</b>。
#!author=773075692, MaYIHEI（脚本）· Minis（Loon 外壳）
#!homepage=https://github.com/onshine/ScriptHubs/tree/main/agentrouter
#!icon=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/icon.png
#!tag=签到
#!loon_version=3.5.1(983)

[Argument]
username = input,"",tag=账号,desc=网站账号或邮箱；用多账号 JSON 时可留空
password = input,"",tag=密码,desc=网站登录密码
accounts = input,"",tag=多账号（JSON）,desc=选填，填了优先用列表；格式见插件主页 README
merge = switch,false,tag=静默（由签到汇总统一推送）,desc=配合「Paperclip · 签到合集」的统一通知使用；单独安装时保持关闭
debug = switch,false,tag=调试模式,desc=在 Loon 日志里打印请求状态与签到判定

[Script]
cron "0 9 * * *" then script("https://raw.githubusercontent.com/onshine/ScriptHubs/main/agentrouter/agentrouter.js", {${username}, ${password}, ${accounts}, ${debug}, ${merge}}) with tag="AgentRouter签到", img_url="https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/agentrouter/icon.png", timeout=1200
